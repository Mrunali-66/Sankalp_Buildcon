# =========================================================
# Sankalp Buildcon - Contact Form Email Configuration
# =========================================================

# 1. Recipient Email Address:
# Enquiries submitted on the website will be sent to this email address.
# Change this to your client's business email for production.
CONTACT_EMAIL=mrunalihajare5@gmail.com

# 2. Email Service Provider API Key:
# Production email delivery via Resend (https://resend.com).
# Sign up at https://resend.com to generate your API key (starts with 're_').
EMAIL_API_KEY=your_secret_email_api_key_here
RESEND_API_KEY=your_secret_email_api_key_here

# 3. Optional Custom Sender Email:
# Defaults to "Sankalp Buildcon <onboarding@resend.dev>".
# When you verify your custom domain in Resend, uncomment and update:
# FROM_EMAIL=Sankalp Buildcon <enquiries@sankalpbuildcon.com>
